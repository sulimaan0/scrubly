{
    "dashboard": {
      "title": "Demographics Report",
      "layout": {
        "container": {
          "backgroundColor": "white",
          "borderRadius": "24px",
          "padding": "32px",
          "maxWidth": "1200px",
          "boxShadow": "0 20px 60px rgba(0, 0, 0, 0.1)"
        },
        "background": {
          "gradient": "linear-gradient(135deg, #6B5FED 0%, #4F46E5 50%, #3B82F6 100%)"
        }
      },
      "header": {
        "title": {
          "text": "Demographics Report",
          "fontSize": "32px",
          "fontWeight": "700",
          "color": "#1A1A1A"
        },
        "actions": {
          "search": {
            "icon": "search",
            "backgroundColor": "transparent"
          },
          "customize": {
            "text": "Customize",
            "icon": "sliders",
            "backgroundColor": "#F3F4F6",
            "borderRadius": "8px",
            "padding": "8px 16px"
          },
          "addNew": {
            "text": "Add New",
            "icon": "upload",
            "backgroundColor": "#F3F4F6",
            "borderRadius": "8px",
            "padding": "8px 16px"
          }
        }
      },
      "sidebar": {
        "width": "80px",
        "backgroundColor": "#FAFAFA",
        "borderRadius": "16px 0 0 16px",
        "items": [
          {
            "icon": "home",
            "active": true,
            "color": "#6B5FED"
          },
          {
            "icon": "chart",
            "active": false,
            "color": "#9CA3AF"
          },
          {
            "icon": "users",
            "active": false,
            "color": "#9CA3AF"
          },
          {
            "icon": "calendar",
            "active": false,
            "color": "#9CA3AF"
          },
          {
            "icon": "zap",
            "active": false,
            "color": "#9CA3AF"
          },
          {
            "icon": "bell",
            "active": false,
            "color": "#9CA3AF"
          }
        ],
        "bottomItems": [
          {
            "icon": "settings",
            "color": "#9CA3AF"
          },
          {
            "type": "avatar",
            "image": "user-profile.jpg",
            "borderRadius": "50%",
            "size": "40px"
          }
        ]
      },
      "metricsCards": {
        "layout": {
          "display": "grid",
          "gridTemplateColumns": "repeat(4, 1fr)",
          "gap": "24px",
          "marginBottom": "32px"
        },
        "cards": [
          {
            "title": "Audience",
            "badge": {
              "text": "New",
              "backgroundColor": "#EEF2FF",
              "color": "#6B5FED",
              "borderRadius": "4px",
              "padding": "2px 8px",
              "fontSize": "12px"
            },
            "value": "1,878",
            "trend": {
              "direction": "up",
              "percentage": "+12%",
              "text": "vs last month",
              "color": "#10B981"
            },
            "icon": "users",
            "iconColor": "#9CA3AF",
            "backgroundColor": "white",
            "borderRadius": "16px",
            "padding": "24px",
            "boxShadow": "0 1px 3px rgba(0, 0, 0, 0.05)"
          },
          {
            "title": "Visitors",
            "value": "21,022",
            "trend": {
              "direction": "down",
              "percentage": "-8%",
              "text": "vs last month",
              "color": "#EF4444"
            },
            "icon": "eye",
            "iconColor": "#9CA3AF",
            "backgroundColor": "white",
            "borderRadius": "16px",
            "padding": "24px",
            "boxShadow": "0 1px 3px rgba(0, 0, 0, 0.05)"
          },
          {
            "title": "Conversion",
            "value": "9,881,118",
