        ],
        "typography": {
          "title": {
            "fontSize": "14px",
            "color": "#6B7280",
            "fontWeight": "500"
          },
          "value": {
            "fontSize": "36px",
            "color": "#1A1A1A",
            "fontWeight": "700"
          },
          "trend": {
            "fontSize": "13px",
            "fontWeight": "500"
          }
        }
      },
      "targetDemographics": {
        "header": {
