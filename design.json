              "direction": "up",
              "percentage": "+8.9%",
              "text": "vs last month",
              "color": "#10B981"
            },
            "icon": "grid",
            "iconColor": "#9CA3AF",
            "backgroundColor": "white",
            "borderRadius": "16px",
            "padding": "24px",
            "boxShadow": "0 1px 3px rgba(0, 0, 0, 0.05)"
