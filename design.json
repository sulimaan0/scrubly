          {
            "title": "Total Rate",
            "badge": {
              "text": "Beta",
              "backgroundColor": "#FEF3F2",
              "color": "#EF4444",
              "borderRadius": "4px",
              "padding": "2px 8px",
              "fontSize": "12px"
            },
            "value": "187%",
            "trend": {
              "direction": "up",
              "percentage": "+77%",
              "text": "vs last month",
              "color": "#10B981"
            },
            "icon": "dollar-sign",
            "iconColor": "#9CA3AF",
            "backgroundColor": "white",
            "borderRadius": "16px",
            "padding": "24px",
            "boxShadow": "0 1px 3px rgba(0, 0, 0, 0.05)"
